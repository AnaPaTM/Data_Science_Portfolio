theme_excel_new()  +
#theme_tufte()
ggplot(df_2, aes(x = County, y = `Percent of Immigration`, fill = Year)) +
geom_bar(stat = "identity", position = "dodge") +
geom_text(aes(label = lbl), size = 3, position = position_dodge(0.9), vjust = -0.5) +
scale_fill_brewer(palette = "Set2") +
theme_excel_new()
# Load libraries
library(tidyverse)
library(shiny)
library(bslib)
library(broom)
library(DT)
library(expss)
runApp('~/DataScience/Data_613/FinalProject/Res_Mobility')
runApp('~/DataScience/Data_613/FinalProject/Res_Mobility')
runApp('~/DataScience/Data_613/FinalProject/Res_Mobility')
# Load Data Frame
Res_Mobility = readRDS("./data/Res_Mobility_2020_2022.rds")
names(Res_Mobility)
Res_Mobility_2020 = readRDS("../data/Res_Mobility_2020.rds")
Res_Mobility_2021 = readRDS("../data/Res_Mobility_2021.rds")
Res_Mobility_2022 = readRDS("../data/Res_Mobility_2022.rds")
Res_Mobility <- rbind(Res_Mobility_2020, Res_Mobility_2021, Res_Mobility_2022)
Res_Mobility %>%
mutate(
`Proportion of Male` = round((total_pop_male / total_pop), 3),
`Proportion of Female` = round((total_pop_female / total_pop), 3),
`Percent of Immigration` = (pct_moved_difcounty_samestate + pct_moved_diffstate + pct_moved_from_abroad),
`Proportion With Less Than Bechelor` = round(((pop_25_years_and_over_less_highschool +
pop_25_years_and_over_with_highschool +
pop_25_years_and_over_some_college) / pop_25_years_and_over), 3),
`Proportion With Bachelor's Degree` = round((pop_25_years_and_over_bachdegree/pop_25_years_and_over), 3),
`Proportion Graduate Degree` = round((pop_25_years_and_over_graduateplus/pop_25_years_and_over), 3),
`Proportion Below Povert Line 100` = round((pop_tot_povstatus_below_100/pop_tot_povstatus_determined), 3),
lbl = scales::percent(`Percent of Immigration`, accuracy = 0.1, scale = 1,)
) %>%
select(State, County, Year,
`Median Age`,
`Median Income` ,
`Proportion of Male`,
contains(c("Proportion", "Percent")),
lbl
) -> Res_Mobility_2020_2022
glimpse(Res_Mobility_2020_2022)
write_rds(Res_Mobility_2020_2022, "../data/Res_Mobility_2020_2022.rds", compress = "gz")
# Load Data Frame
Res_Mobility = readRDS("./data/Res_Mobility_2020_2022.rds")
names(Res_Mobility)
shiny::runApp('~/DataScience/Data_613/FinalProject/Res_Mobility')
