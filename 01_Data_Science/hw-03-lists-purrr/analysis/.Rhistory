calcn <- function(x, n) {
if (length(x) < 3) {
stop("Error: The x vector must have at least three elements.")
}
if (n <= 3) {
return(paste0("The x", n, " element of the sequence is: ", x[n]))
}
x_n <- seq_along(n)
x_n[1:3] <- x
for (i in 4:n) {
x_n[i] <- x_n[i - 1] + abs(x_n[i - 2] - x_n[i - 3]) / 5
}
return(paste0("The x", n, "th element of the sequence is: ", x_n[n]))
}
calcn(x = c(2, 4, 3), n = 3L)
calcn(x = c(2, 4, 3), n = 4L)
calcn(x = c(2, 4, 3), n = 5L)
calcn(x = c(2, 4, 3), n = 6L)
calcn(x = c(2, 4, 3), n = 7L)
