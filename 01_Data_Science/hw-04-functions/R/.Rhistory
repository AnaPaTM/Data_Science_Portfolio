# Function to generate plots based on variable class
generate_plots_by_class <- function(df, class_type) {
# Check for valid class type
valid_classes <- c("character", "factor", "logical", "double", "integer", "numeric")
if (!(class_type %in% valid_classes)) {
stop("Invalid class type. Please use one of the following: character, factor, logical, double, integer, numeric.")
}
# Select variables matching the specified class type
selected_vars <- df %>%
select(where(~ class(.) == class_type))
if (ncol(selected_vars) == 0) {
stop("No variables of the specified class found.")
}
# Convert data to long format for plotting
long_data <- selected_vars %>%
pivot_longer(everything(), names_to = "variable", values_to = "value")
# Create plots
plots <- long_data %>%
group_by(variable) %>%
do(plot = ggplot(., aes(x = value)) +
geom_bar() +
labs(title = unique(.$variable)) +
theme_minimal())
# Return list of plots
return(plots$plot)
}
data(mpg)
head(mpg, 6)
generate_plots_by_class(mpg, "character")
df_attributes <- function(df) {
# Validate inputs
stopifnot("The input must be a data frame" = is.data.frame(df),
"This data frame must have more than one row" = nrow(df) > 1)
# Create a data frame with the attributes from the input data frame
df_str <- data.frame(variable_name = names(df),
variable_class = sapply(df, class),
variable_type = sapply(df, typeof),
unique_values = sapply(df, function(x) length(unique(x))),
na_count = sapply(df, function(x) sum(is.na(x)))
)
return(df_str)
}
