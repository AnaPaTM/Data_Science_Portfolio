library(tidyverse)
df_attributes <- function(df, name) {
# Error message if input arguments don't meet specified requirements
stopifnot("This is not a data frame" = is.data.frame(df),
"This data frame must have more than one row" = nrow(df) > 1)
# Creating a data frame with the attributes from the input data frame
df_str <- tibble(variable_name = names(df),
variable_class = sapply(df, class),
variable_type = sapply(df, typeof),
unique_values = sapply(df, function(x) length(unique(x))),
na_count = sapply(df, function(x) sum(is.na(x)))
)
df_summary = return(df_str)
}
