library(ggplot2)
library(dplyr)
plot_by_class <- function(df, class_name) {
# Validate inputs
if (!is.data.frame(df) || nrow(df) < 1) {
stop("Input must be a data frame with at least one row.")
}
# Get the variable names that match the class
class_vars <- sapply(df, class)
matching_vars <- names(class_vars[class_vars == class_name])
# If no matching variables found, return error message
if (length(matching_vars) == 0) {
stop(paste(deparse(substitute(df)), "has no variables of class", class_name))
}
# Prepare plots
plots <- list()
for (var in matching_vars) {
p <- NULL
if (class_name %in% c("character", "factor", "logical")) {
# Bar plots for character, factor, or logical
count_data <- df %>%
group_by(.data[[var]]) %>%
summarise(count = n()) %>%
ungroup()
p <- ggplot(count_data, aes_string(x = var, y = "count")) +
geom_bar(stat = "identity") +
labs(title = paste(deparse(substitute(df)), " - Counts of", var),
x = var, y = "Count") +
theme_minimal()
# Check number of variables and flip coordinates if necessary
if (length(matching_vars) > 7) {
p <- p + coord_flip()
}
} else if (class_name %in% c("double", "integer", "numeric")) {
# Histograms for numeric types
p <- ggplot(df, aes_string(x = var)) +
geom_histogram(bins = 30, fill = "blue", color = "black", alpha = 0.7) +
labs(title = paste(deparse(substitute(df)), " - Histogram of", var),
x = var, y = "Frequency") +
theme_minimal()
}
# Store the plot
plots[[var]] <- p
}
# Return the list of plots
return(plots)
}
