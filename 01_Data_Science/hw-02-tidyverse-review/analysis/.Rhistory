gpt_with_logicals %>%
#select(Country, Duration, start_date) %>%
mutate(protest_ints_with_dec = parse_number(str_extract(Duration, my_regex_int_with_dec)),
protest_dtperiods = str_extract(Duration, my_regex_dtnames),
N_days_active_today = parse_number(str_extract(difftime(Sys.Date(), start_date, units = "days"), my_regex_integers))
) %>%
mutate(protest_days = if_else(str_detect(protest_dtperiods, "Active"), N_days_active_today,
if_else(str_detect(protest_dtperiods, "day"), protest_ints_with_dec,
if_else(str_detect(protest_dtperiods, "week"), protest_ints_with_dec*7,
if_else(str_detect(protest_dtperiods, "month"), protest_ints_with_dec*30,
if_else(str_detect(protest_dtperiods, "year"), protest_ints_with_dec*365, 0)))))
) -> gpt_with_protest_days
glimpse(gpt_with_protest_days)
gpt_with_protest_days %>%
filter(protest_dtperiods != "Active") %>%
arrange(desc(protest_days)) %>%
select(`Country`, start_date, protest_days) %>%
slice_max(protest_days, n=30) -> A
print(A)
gpt_with_protest_days %>%
filter(protest_dtperiods != "Active") %>%
arrange(desc(protest_days)) %>%
select(`Country`, start_date, protest_days) %>%
slice_max(protest_days, n=30)
