#| name: load-eowl
library(tidyverse)
#install.packages("gapminder")
library(gapminder)
#help(gapminder)
glimpse(gapminder)
wd_country_income <- read_csv("../data/wb_country_income_classification_2023.csv",
col_names = TRUE,
na = c("NA", "..", ""),
skip_empty_rows = TRUE,
n_max = 267)
glimpse(wd_country_income)
names(wd_country_income) <- c("economy"	,
"code"	,
"region" ,
"income_group" ,
"lending_category")
glimpse(wd_country_income)
#shows only what is in x and not in y.
gapminder_names_only = anti_join(gapminder, wd_country_income, by = join_by("country" == "economy"))
gapminder_names_only %>%
group_by(country) %>%
count()
gapminder_names_only = anti_join(wd_country_income, gapminder, by = join_by("country" == "economy"))
gapminder_names_only = anti_join(wd_country_income, gapminder, by = join_by("economy" == "country"))
gapminder_names_only %>%
group_by(country) %>%
count()
gapminder_names_only %>%
group_by(economy) %>%
count()
#shows only what is in x and not in y.
gapminder_names_only = anti_join(gapminder, wd_country_income, by = join_by("country" == "economy"))
gapminder_names_only %>%
group_by(country) %>%
count()
#install.packages("readxl")
library(readxl)
global_protest_tracker <- read_excel("../data/Global Protest Tracker.xlsx",
skip = 3,
n_max = 719)
glimpse(global_protest_tracker)
global_protest_tracker %>%
mutate(start_date_char = if_else(`Start Date` == "Mar-24", "24-Mar", `Start Date`),
start_date = parse_date_time(start_date_char, "ym")
) -> gpt_newfile
glimpse(gpt_newfile)
gpt_newfile %>%
mutate(peak_size = if_else(`Peak Size` == "Tens of thousands", "20000",
if_else(`Peak Size` == "Thousands", "3000",
if_else(`Peak Size` == "Unknown", "", `Peak Size`
)))) %>%
mutate(peak_size = str_replace_all(peak_size, "^(>|<)", ""),
peak_size = str_replace_all(peak_size, " million", "00,000"),
peak_size = str_replace_all(peak_size, ",+", ""),
peak_size = str_replace_all(peak_size, "\\.", "")
) %>%
mutate(peak_size_claen = str_trim(peak_size, side = "both"),
peak_size_num = parse_number(peak_size_claen)
) -> gpt_newfile_clean
glimpse(gpt_newfile_clean)
gpt_newfile_clean %>%
select(`Country`, `Protest Name`, peak_size_num) %>%
filter(peak_size_num == 3000 | peak_size_num == 20000 | peak_size_num == 1000000 | peak_size_num == 1200000 | peak_size_num == 1500000) %>%
arrange(desc(peak_size_num))
make_logical <- function(vec) as.logical(if_else(is.na(vec), 0, 1))
many_nas <- function(vec) sum(is.na(vec)) > 10
gpt_newfile_clean %>%
mutate(across(contains(c("protests", "motivation", "significant", "protesting", "government", "Coronavirus")), make_logical)) -> gpt_with_logicals
glimpse(gpt_with_logicals)
my_regex_integers <- "(\\d+)"
my_regex_int_with_dec <- "(\\d{1}\\.\\d{1})|(\\d+)"
my_regex_dtnames <- "(months|month|weeks|week|years|year|days|day|Active)"
gpt_with_logicals %>%
#select(Country, Duration, start_date) %>%
mutate(protest_ints_with_dec = parse_number(str_extract(Duration, my_regex_int_with_dec)),
protest_dtperiods = str_extract(Duration, my_regex_dtnames),
N_days_active_today = parse_number(str_extract(difftime(Sys.Date(), start_date, units = "days"), my_regex_integers))
) %>%
mutate(protest_days = if_else(str_detect(protest_dtperiods, "Active"), N_days_active_today,
if_else(str_detect(protest_dtperiods, "day"), protest_ints_with_dec,
if_else(str_detect(protest_dtperiods, "week"), protest_ints_with_dec*7,
if_else(str_detect(protest_dtperiods, "month"), protest_ints_with_dec*30,
if_else(str_detect(protest_dtperiods, "year"), protest_ints_with_dec*365, 0)))))
) -> gpt_with_protest_days
gpt_with_protest_days
gpt_with_protest_days %>%
summarise(sum_protest_days = sum(protest_days))
gpt_with_protest_days %>%
filter(protest_dtperiods != "Active") %>%
arrange(desc(protest_days)) %>%
select(`Country`, start_date, protest_days) %>%
slice_max(protest_days, n=30)
gpt_with_protest_days %>%
mutate(size_cat_ft = as.factor(`Size category`),
size_cat_ft = fct_recode(size_cat_ft,
"Thousands"             = "Thosuands",
"Thousands"             = "Thousads",
"Hundreds of thousands" = "Huundreds of thousands",
"Hundreds of thousands" = "Hundreds of of thousands")) %>%
mutate(size_cat_ft = fct_relevel(size_cat_ft, c("Tens", "Dozens", "Hundreds", "Thousands", "Tens of thousands", "Hundreds of thousands", "Over 1 million", "Millions", "Tens of millions", "Unknown")
)
) -> gpt_with_pdays_size_fcts
gpt_with_pdays_size_fcts %>%
group_by(size_cat_ft) %>%
count()
#| eval: false
#| echo: true
gpt_with_pdays_size_fcts %>%
select(peak_size_num, size_cat_ft) %>%
arrange(size_cat_ft) -> gpt_size_fcts2
#view(gpt_size_fcts2)
gpt_size_fcts2
#| eval: false
#| echo: true
gpt_with_pdays_size_fcts %>%
select(peak_size_num, size_cat_ft) %>%
arrange(size_cat_ft) -> gpt_size_fcts2
#view(gpt_size_fcts2)
gpt_size_fcts2
ggplot(gpt_with_pdays_size_fcts, mapping = aes(x = protest_days,
y = peak_size_num,
color = `Violent government response`)) +
geom_point() +
scale_x_log10() +
scale_y_log10() +
geom_smooth(se = FALSE, linetype = "solid") +
xlab("Length of Protest in Days") +
ylab("Peak Size") +
ggtitle(label = "Peak Size of Protests with Significant Outcome Versus the Length of the Protest",
subtitle = "Log Scales") +
labs(caption = "Data from the Carnegie Foundation Endowment for Peace Global Protest Tracker") +
theme(plot.title = element_text(hjust = 0.5, size = 11),
plot.subtitle = element_text(size = 10, hjust = 0.5)
)
