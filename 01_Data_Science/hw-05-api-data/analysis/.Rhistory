library(jsonlite)
library(repurrrsive)
url_FDA <- "https://api.fda.gov/drug/event.json?count=receiptdate"
#key_set("API_MYKEY_FDA_GOV")
#key_get("API_MYKEY_FDA_GOV")
req2 <- request(url_FDA) %>%
req_url_query(api_key = key_get("API_MYKEY_FDA_GOV")) %>%
req_url_query(search = "patient.reaction.reactionmeddrapt:fatigue") %>%
req_url_query(limit = 100) %>%
req_perform() -> search_req2
str(search_req2)
resp_body_FDA <- resp_body_json(search_req2)
glimpse(search_req2)
resp_body_FDA <- resp_body_json(search_req2)
glimpse(search_req2)
url <- "https://api.si.edu/openaccess/api/v1.0/search"
req <- request(url) %>%
req_url_query(q = "artificial intelligence") %>%
req_url_query(rows = 10) %>%
req_url_query(start = 0) %>%
req_url_query(api_key = key_get("API_MYKEY_DATA_GOV")) %>%
req_perform() -> search_req
str(search_req)
search_req
resp_status(search_req)
resp_body <- resp_body_json(search_req)
glimpse(resp_body)
search_req2
resp_body_FDA <- resp_body_json(search_req2)
glimpse(search_req2)
glimpse(resp_body_FDA)
search_req2
resp_body_FDA <- resp_body_json(search_req2)
glimpse(resp_body_FDA)
resp_list_FDA <- resp_body_FDA$results
glimpse(resp_list_FDA)
resp_df_FDA <- tibble(fatigue = resp_list_FDA)
glimpse(resp_df_FDA)
glimpse(resp_body_FDA[1:3])
glimpse(resp_body_FDA)
glimpse(resp_body_FDA[1])
search_req2
resp_body_FDA <- resp_body_json(search_req2)
glimpse(resp_body_FDA)
resp_df_FDA %>%
unnest_wider(fatigue) -> fatigue_reaction
View(fatigue_reaction)
glimpse(resp_df_FDA)
glimpse(fatigue_reaction)
