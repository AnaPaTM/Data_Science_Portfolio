install.packages("tidyverse")
install.packages("ISLR2")
install.packages("trees")
install.packages("tree")
#| message: false
#| echo: fenced
library(tidyverse)
library(ISLR2)
# ?OJ
glimpse(OJ)
?OJ
# ?OJ
glimpse(OJ)
set.seed(1234)
n <- nrow(OJ)
Z <- sample(1:n, 600)
train <- OJ[Z,]
test <- OJ[-Z,]
library(tree)
tr <- tree(Purchase ~ ., data = train)
summary(tr)
tr
plot(tr)
text(tr)
yhat = predict(tr, newdata = test, type = "class")
table(yhat, test$Purchase)
yhat = predict(tr, newdata = test, type = "class")
table(yhat, test$Purchase)
mean(yhat != test$Purchase )
set.seed(1234)
cv <- cv.tree(tr, FUN = prune.misclass)
cv
plot(cv)
which.min(cv$dev)
trp <- prune.misclass(tr, best = 4)
summary(trp)
summary(tr)$misclass[1]/summary(tr)$misclass[2] # Original
summary(tr)$misclass[1]/summary(tr)$misclass[2] # Original
summary(trp)$misclass[1]/summary(trp)$misclass[2] # Pruned
table(Purchase)
#| message: false
#| echo: fenced
library(tidyverse)
library(ISLR2)
# ?OJ
glimpse(OJ)
table(OJ$Purchase)
plot(tr)
text(tr)
yhat = predict(tr, newdata = test, type = "class")
table(yhat, test$Purchase)
mean(yhat != test$Purchase )
which.min(cv$dev)
trp <- prune.misclass(tr, best = 4)
summary(trp)
summary(tr)$misclass[1]/summary(tr)$misclass[2]
summary(trp)$misclass[1]/summary(trp)$misclass[2]
yhat = predict(tr, newdata = test, type = "class")
mean(yhat != test$Purchase )
yhatp = predict(trp, newdata = test, type = "class")
mean(yhatp != test$Purchase )
