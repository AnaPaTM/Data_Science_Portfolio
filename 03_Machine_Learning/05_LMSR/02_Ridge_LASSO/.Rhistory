library(tidyverse)
library(ISLR2)
library(pls)
glimpse(College)
n <- nrow(College)
set.seed(123)
Z <- sample(1:n, n/2)
train_data <- College[Z, ]
test_data <- College[-Z, ]
set.seed(123)
pcrv_fit <- pcr(Apps ~ ., data = train_data, scale = TRUE, validation = "CV")
summary(pcrv_fit)
vip::vip(pcr_fit)
install.packages("vip")
vip::vip(pcr_fit)
vip::vip(pcrv_fit)
install.packages("caret")
library(vip)
vip::vip(pcrv_fit)
plot(pcrv_fit)
abline(0, 1, col = "red")
validationplot(pcrv_fit, val.type = "MSEP")
opt_M <- which.min(pcr_fit$validation$PRESS)
opt_M <- which.min(pcrv_fit$validation$PRESS)
opt_M
pcr_pred <- predict(pcrv_fit, test_data, ncomp = opt_M)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
pcr_pred <- predict(pcrv_fit, test_data, ncomp = opt_M)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
pcr_pred <- predict(pcrv_fit, test_data, ncomp = 9)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
pcr_pred <- predict(pcrv_fit, test_data, ncomp = opt_M)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
pcr_pred <- predict(pcrv_fit, test_data, ncomp = 4)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
plot(pcrv_fit)
abline(0, 1, col = "red")
opt_M <- which.min(pcrv_fit$validation$PRESS)
opt_M
pcrv_fit
pcr_pred <- predict(pcrv_fit, test_data, ncomp = opt_M)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
pcr_pred <- predict(pcrv_fit, test_data, ncomp = 4)
test_MSE <- mean((pcr_pred - test_data$Apps)^2)
test_MSE
set.seed(123)
pcrv_fit <- pcr(Apps ~ ., data = train_data, scale = TRUE, validation = "CV")
summary(pcrv_fit)
set.seed(123)
plsrv_fit <- plsr(Apps ~ ., data = train_data, scale = TRUE, validation = "CV")
summary(plsrv_fit)
vip::vip(plsrv_fit)
plot(plsrv_fit)
abline(0, 1, col = "red")
opt_M <- which.min(plsrv_fit$validation$PRESS)
opt_M
plsr_pred <- predict(plsrv_fit, test_data, ncomp = opt_M)
test_MSE <- mean((plsr_pred - test_data$Apps)^2)
test_MSE
