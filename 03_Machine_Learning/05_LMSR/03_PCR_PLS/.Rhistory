library(pls)
glimpse(Boston)
reg <- lm(medv ~ ., data = Boston)
x <- model.matrix(reg)[, -1]
dim(x)
set.seed(1234)
rr_cv <- cv.glmnet(x, y= Boston$medv, alpha = 0)
rr_cv
plot(rr_cv)
set.seed(1234)
lr_cv <- cv.glmnet(x, y= Boston$medv, alpha = 1)
lr_cv
plot(lr_cv)
pcr_fit <- pcr(medv ~ ., data = Boston,
scale = TRUE,
validation = "CV")
summary(pcr_fit)
pls_fit <- plsr(medv ~ ., data = Boston,
scale = TRUE,
validation = "CV")
summary(pls_fit)
rr_pred <- predict(rr_cv, s = "lambda.1se")
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x)
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "min")
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.min")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((Boston$medv - rr_pred)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.min")
mean((rr_pred - Boston$medv)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.1se")
mean((rr_pred - Boston$medv)^2) |> round(3)
rr_pred <- predict(rr_cv, newx = x, s = "lambda.min")
mean((rr_pred - Boston$medv)^2) |> round(3)
lr_pred <- predict(lr_cv, newx = x, s = "lambda.1se")
mean((lr_pred - Boston$medv)^2) |> round(3)
lr_pred <- predict(lr_cv, newx = x, s = "lambda.min")
mean((lr_pred - Boston$medv)^2) |> round(3)
opt_M_medv_pcr <- which.min(pcr_medv_fit$validation$PRESS)
pcr_medv_fit <- pcr(medv ~ ., data = Boston,
scale = TRUE,
validation = "CV")
summary(pcr_medv_fit)
opt_M_medv_pcr <- which.min(pcr_medv_fit$validation$PRESS)
opt_M_medv_pcr
pcr_medv_pred <- predict(pcr_medv_fit, Boston, ncomp = opt_M_medv_pcr)
MSE_pcr <- mean((pcr_medv_pred - Boston$medv)^2)
MSE_pcr
pls_medv_fit <- plsr(medv ~ ., data = Boston,
scale = TRUE,
validation = "CV")
summary(pls_medv_fit)
opt_M_medv_pls <- which.min(pls_medv_fit$validation$PRESS)
opt_M_medv_pls
pls_medv_pred <- predict(pls_medv_fit, Boston, ncomp = opt_M_medv_pls)
MSE_pls <- mean((pls_medv_pred - Boston$medv)^2)
MSE_pls
Boston |>
dplyr::mutate(rad = as.factor(rad)) ->
Boston_rf
Xrf <- model.matrix(lm(medv ~ ., data = Boston_rf))[,-1]
Boston |>
dplyr::mutate(rad = as.factor(rad)) ->
Boston_rf
Xrf <- model.matrix(lm(medv ~ ., data = Boston_rf))[,-1]
set.seed(1234)
lr_cv <- cv.glmnet(Xrf, y = Boston_rf$medv, alpha = 1)
lr_cv
lr_pred <- predict(lr_cv, newx = Xrf, s = "lambda.1se")
mean((lr_pred - Boston_rf$medv)^2) |> round(3)
lr_pred <- predict(lr_cv, newx = Xrf, s = "lambda.min")
mean((lr_pred - Boston_rf$medv)^2) |> round(3)
pls_medv_fit <- plsr(medv ~ ., data = Boston_rf,
scale = TRUE,
validation = "CV")
summary(pls_medv_fit)
opt_M_medv_pls <- which.min(pls_medv_fit$validation$PRESS)
opt_M_medv_pls
pls_medv_pred <- predict(pls_medv_fit, Boston_rf, ncomp = opt_M_medv_pls)
MSE_pls <- mean((pls_medv_pred - Boston_rf$medv)^2)
MSE_pls
X_no_rad <- model.matrix(lm(medv ~ . -rad, data = Boston_rf))[,-1]
dim(X_no_rad)
View(X_no_rad)
View(Xrf)
set.seed(1234)
lr_cv <- cv.glmnet(X_no_rad, y = Boston_rf$medv, alpha = 1)
lr_cv
lr_pred <- predict(lr_cv, newx = X_no_rad, s = "lambda.1se")
mean((lr_pred - Boston_rf$medv)^2) |> round(3)
lr_pred <- predict(lr_cv, newx = X_no_rad, s = "lambda.min")
mean((lr_pred - Boston_rf$medv)^2) |> round(3)
set.seed(1234)
lr_cv_rf <- cv.glmnet(Xrf, y = Boston_rf$medv, alpha = 1)
lr_cv_rf
lr_pred_rf <- predict(lr_cv_rf, newx = Xrf, s = "lambda.1se")
mean((lr_pred_rf - Boston_rf$medv)^2) |> round(3)
lr_pred_rf <- predict(lr_cv_rf, newx = Xrf, s = "lambda.min")
mean((lr_pred_rf - Boston_rf$medv)^2) |> round(3)
lr_pred_rf <- predict(lr_cv_rf, newx = Xrf, s = "lambda.min")
mean((lr_pred_rf - Boston_rf$medv)^2) |> round(3)
lr_pred_rf <- predict(lr_cv_rf, newx = Xrf, s = "lambda.1se")
mean((lr_pred_rf - Boston_rf$medv)^2) |> round(3)
#| label: compare-coefs
dplyr::bind_rows(
coef(lr_cv) |> round(3) |> as.matrix() |> as.data.frame() |> tibble::rownames_to_column(),
coef(lr_cv_rf) |> round(3) |> as.matrix() |> as.data.frame() |> tibble::rownames_to_column()
) |>
dplyr::mutate(model = c(rep("lasso", length(coef(lr_cv))), rep("lasso-rf", length(coef(lr_cv_rf))))) |>
dplyr::arrange(rowname) |>
tidyr::pivot_wider(names_from = rowname, values_from = s1) |>
